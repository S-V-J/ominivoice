# OminiVoice Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# DATABASE
# =============================================================================
# PostgreSQL connection string
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://ominivoice:ominivoice_dev@postgres:5432/ominivoice

# =============================================================================
# REDIS
# =============================================================================
# Redis connection string for cache, sessions, and Celery broker
# Format: redis://[:password]@host:port/db
REDIS_URL=redis://redis:6379/0

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
# JWT secret key for signing access/refresh tokens
# Generate with: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars

# JWT algorithm (HS256, RS256, etc.)
JWT_ALGORITHM=HS256

# Access token expiration (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh token expiration (days)
REFRESH_TOKEN_EXPIRE_DAYS=7

# Bcrypt rounds for password hashing
BCRYPT_ROUNDS=12

# =============================================================================
# STRIPE BILLING
# =============================================================================
# Stripe secret key (test mode: sk_test_..., live: sk_live_...)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Stripe publishable key (test: pk_test_..., live: pk_live_...)
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Stripe webhook secret for verifying webhook signatures
# Get from Stripe Dashboard > Webhooks > Signing secret
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Stripe price IDs for subscription tiers
STRIPE_PRICE_ID_STARTER=price_starter_monthly
STRIPE_PRICE_ID_PRO=price_pro_monthly
STRIPE_PRICE_ID_ENTERPRISE=price_enterprise_monthly

# =============================================================================
# NVIDIA API (Hosted LLM Provider)
# =============================================================================
# NVIDIA API key for integrate.api.nvidia.com
# Get from: https://integrate.api.nvidia.com/
NVIDIA_API_KEY=nvapi_your_nvidia_api_key

# NVIDIA base URL (default is correct for most users)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Default model to use (can be overridden per-agent)
NVIDIA_DEFAULT_MODEL=stepfun-ai/step-3.7-flash

# =============================================================================
# OLLAMA (Self-hosted LLM)
# =============================================================================
# Ollama base URL
OLLAMA_BASE_URL=http://ollama:11434

# Default Ollama model
OLLAMA_DEFAULT_MODEL=qwen3:4b

# =============================================================================
# STT (Speech-to-Text)
# =============================================================================
# STT engine: faster-whisper, whisper
STT_ENGINE=faster-whisper

# faster-whisper model size: tiny, base, small, medium, large-v3
STT_MODEL_SIZE=base

# Device: cpu, cuda
STT_DEVICE=cpu

# Compute type: int8, int8_float16, float16, float32
STT_COMPUTE_TYPE=int8

# =============================================================================
# TTS (Text-to-Speech)
# =============================================================================
# TTS engine: kokoro, piper
TTS_ENGINE=kokoro

# Kokoro settings
KOKORO_MODEL_PATH=/models/kokoro-v1.0.onnx
KOKORO_VOICES_PATH=/models/voices
KOKORO_DEFAULT_VOICE=af_heart

# Piper settings (fallback)
PIPER_MODEL_PATH=/models/piper/en_US-lessac-medium.onnx
PIPER_DEFAULT_VOICE=en_US-lessac-medium

# =============================================================================
# VAD (Voice Activity Detection)
# =============================================================================
# VAD engine: silero
VAD_ENGINE=silero

# Silero VAD threshold (0.0-1.0, higher = more sensitive)
VAD_THRESHOLD=0.5

# =============================================================================
# PIPECAT / VOICE ENGINE
# =============================================================================
# Voice engine host/port for internal communication
VOICE_ENGINE_HOST=0.0.0.0
VOICE_ENGINE_PORT=8080

# WebRTC settings for FastRTC (simulated calls)
FASTRTC_HOST=0.0.0.0
FASTRTC_PORT=7860

# =============================================================================
# API SETTINGS
# =============================================================================
# API host/port
API_HOST=0.0.0.0
API_PORT=8000

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://frontend:3000

# Rate limiting (requests per minute per API key)
API_RATE_LIMIT=60

# =============================================================================
# FRONTEND
# =============================================================================
# Frontend URL (for email links, redirects, etc.)
FRONTEND_URL=http://localhost:3000

# Vite dev server port
VITE_PORT=5173

# =============================================================================
# CELERY / BACKGROUND WORKERS
# =============================================================================
# Celery broker URL (uses Redis)
CELERY_BROKER_URL=redis://redis:6379/1

# Celery result backend
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Celery worker concurrency
CELERY_WORKER_CONCURRENCY=4

# =============================================================================
# LOGGING & MONITORING
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Enable structured JSON logging
STRUCTURED_LOGGING=true

# Sentry DSN (optional)
SENTRY_DSN=

# =============================================================================
# EMAIL (Optional - for notifications, password reset)
# =============================================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@ominivoice.com

# Email rate limiting (emails per user per hour)
EMAIL_RATE_LIMIT_PER_HOUR=50